<?xml version="1.0" encoding="utf-8"?>

<!-- 
	在 fedora-kiwi-descriptions2/kiwi-build 基础上修改
	重写了 include 列表

 -->

<image schemaversion="7.4" name="Fedora">
	<description type="system">
		<author>Fedora Project Contributors</author>
		<contact>devel@lists.fedoraproject.org</contact>
		<specification>Fedora Linux</specification>
	</description>
	<preferences>
		<version>43</version>
		<packagemanager>dnf5</packagemanager>
		<locale>en_US</locale>
		<keytable>us</keytable>
		<timezone>UTC</timezone>
		<release-version>43</release-version>
	</preferences>
	<include from="this://./repositories/core.xml">
	<include from="this://./repositories/vscode.xml">


	<include from="this://./fedora/base-common.xml">
	<include from="this://./fedora/boot.xml">
	<include from="this://./fedora/live.xml">
	<include from="this://./fedora/users.xml">
	<include from="this://./fedora/desktop-common.xml">
	<include from="this://./fedora/gnome.xml">
	<include from="this://./fedora/workstation.xml">


	<include from="this://./my/app.xml">

	<packages type="bootstrap">
		<package name="filesystem"/>
	</packages>
</image>
